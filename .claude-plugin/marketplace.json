      "source": {
        "source": "github",
        "repo": "Emasoft/ai-maestro-chief-of-staff"
      },
      "description": "Per-team agent management — staff planning, lifecycle, governance workflows, failure recovery. Requires AI Maestro v0.26.0+.",
      "version": "2.12.0",
      "author": { "name": "Emasoft" },
      "homepage": "https://github.com/Emasoft/ai-maestro-chief-of-staff",
      "license": "MIT",
      "keywords": ["ai", "agents", "chief-of-staff", "governance", "team", "role-plugin"],
      "category": "productivity"
    },
    {
