  },
  "metadata": {
    "description": "Official AI Maestro plugins for Claude Code — agent orchestration, messaging, identity, and role plugins",
    "version": "2.0.0",
    "homepage": "https://github.com/23blocks-OS/ai-maestro",
    "repository": "https://github.com/23blocks-OS/ai-maestro-plugins",
    "plugin_repos": {
      "ai-maestro": "https://github.com/Emasoft/ai-maestro-plugin",
      "agent-messaging": "https://github.com/agentmessaging/claude-plugin",
      "agent-identity": "https://github.com/agentmessaging/agent-identity",
      "ai-maestro-assistant-manager-agent": "https://github.com/Emasoft/ai-maestro-assistant-manager-agent",
      "ai-maestro-chief-of-staff": "https://github.com/Emasoft/ai-maestro-chief-of-staff",
      "ai-maestro-architect-agent": "https://github.com/Emasoft/ai-maestro-architect-agent",
      "ai-maestro-integrator-agent": "https://github.com/Emasoft/ai-maestro-integrator-agent",
      "ai-maestro-orchestrator-agent": "https://github.com/Emasoft/ai-maestro-orchestrator-agent",
      "ai-maestro-programmer-agent": "https://github.com/Emasoft/ai-maestro-programmer-agent"
    }
  },
  "plugins": [
    {
      "name": "ai-maestro",
      "source": {
        "source": "github",
        "repo": "Emasoft/ai-maestro-plugin"
      },
      "description": "AI agent orchestration — agent management, memory search, code graph, docs search, task planning, team governance, team kanban, MCP discovery, and hook debugging.",
      "version": "2.0.0",
      "author": { "name": "23blocks", "email": "hello@23blocks.com" },
      "homepage": "https://github.com/23blocks-OS/ai-maestro",
      "license": "MIT",
      "keywords": ["ai", "agents", "orchestration", "memory", "graph", "governance", "kanban", "mcp"],
      "category": "productivity"
    },
    {
      "name": "agent-messaging",
      "source": {
        "source": "github",
        "repo": "agentmessaging/claude-plugin"
      },
      "description": "Send and receive cryptographically signed messages between AI agents using the Agent Messaging Protocol (AMP). Local messaging, federation, file attachments, Ed25519 signatures.",
      "version": "0.1.3",
      "author": { "name": "Agent Messaging", "email": "info@agentmessaging.org" },
      "homepage": "https://agentmessaging.org",
      "license": "Apache-2.0",
      "keywords": ["messaging", "agent", "communication", "AMP", "federation"],
      "category": "productivity"
    },
    {
      "name": "agent-identity",
      "source": {
        "source": "github",
        "repo": "agentmessaging/agent-identity"
      },
      "description": "Authenticate AI agents with auth servers using the Agent Identity (AID) protocol. Ed25519 identity documents, proof of possession, and OAuth 2.0 token exchange.",
      "version": "0.1.0",
      "author": { "name": "Agent Messaging", "email": "info@agentmessaging.org" },
      "homepage": "https://agentids.org",
      "license": "MIT",
      "keywords": ["identity", "authentication", "agent", "AID", "Ed25519", "OAuth"],
      "category": "productivity"
    },
    {
      "name": "ai-maestro-assistant-manager-agent",
      "source": {
        "source": "github",
        "repo": "Emasoft/ai-maestro-assistant-manager-agent"
      },
      "description": "User's right hand — sole interlocutor with user, directs other roles. Requires AI Maestro for inter-agent messaging.",
      "version": "2.6.0",
      "author": { "name": "Emasoft" },
      "homepage": "https://github.com/Emasoft/ai-maestro-assistant-manager-agent",
      "license": "MIT",
      "keywords": ["ai", "agents", "manager", "assistant", "role-plugin"],
      "category": "productivity"
    },
    {
